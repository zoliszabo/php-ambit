{
    "name": "zoliszabo/php-ambit",
    "description": "Ambit: shared project file scopes and Git change selection.",
    "license": "proprietary",
    "type": "library",
    "require": {
        "php": ">=7.4",
        "symfony/process": "^5.4",
        "symfony/yaml": "^5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.38"
    },
    "autoload": {
        "psr-4": {
            "Ambit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ambit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
